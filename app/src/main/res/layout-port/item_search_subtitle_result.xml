<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/mobile_surface" android:focusable="true" android:minHeight="48dp" android:focusableInTouchMode="false">
