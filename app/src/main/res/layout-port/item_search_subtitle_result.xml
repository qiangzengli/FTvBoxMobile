        <TextView android:id="@+id/subtitleName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="false" android:maxLines="2" android:text="字幕搜索结果" android:textColor="@color/dialog_text_primary" android:textSize="14sp" android:ellipsize="end" />
