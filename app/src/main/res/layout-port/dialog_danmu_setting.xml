<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:background="@android:color/transparent" android:orientation="vertical" android:paddingLeft="0dp" android:paddingTop="12dp" android:paddingRight="16dp" android:paddingBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginBottom="10dp" android:singleLine="true" android:text="弹幕设置" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:layout_width="66dp" android:layout_height="wrap_content" android:gravity="center_vertical|right" android:text="在线弹幕" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
            <TextView android:id="@+id/danmuSearch" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_weight="1" android:background="@drawable/mobile_surface" android:focusable="true" android:gravity="center" android:text="搜索" android:textColor="@color/dialog_text_primary" android:textSize="14sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:layout_width="66dp" android:layout_height="wrap_content" android:gravity="center_vertical|right" android:text="弹幕颜色" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
            <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/trv_color" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="horizontal" app:tv_horizontalSpacingWithMargins="6dp" app:tv_layoutManager="V7LinearLayoutManager" app:tv_selectedItemIsCentered="false" app:tv_verticalSpacingWithMargins="6dp" android:clipChildren="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:layout_width="66dp" android:layout_height="wrap_content" android:gravity="center_vertical|right" android:text="弹幕速度" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
            <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/speed" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="horizontal" app:tv_horizontalSpacingWithMargins="6dp" app:tv_layoutManager="V7LinearLayoutManager" app:tv_selectedItemIsCentered="false" app:tv_verticalSpacingWithMargins="6dp" android:clipChildren="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:layout_width="66dp" android:layout_height="wrap_content" android:gravity="center_vertical|right" android:text="弹幕大小" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/sizeSub" android:layout_width="28dp" android:layout_height="48dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/mobile_surface" android:gravity="center" android:focusable="true" android:text="-" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
                <TextView android:id="@+id/size" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/sizeAdd" android:layout_width="28dp" android:layout_height="48dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/mobile_surface" android:gravity="center" android:focusable="true" android:text="+" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:layout_width="66dp" android:layout_height="wrap_content" android:gravity="center_vertical|right" android:text="弹幕行数" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/lineSub" android:layout_width="28dp" android:layout_height="48dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/mobile_surface" android:gravity="center" android:focusable="true" android:text="-" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
                <TextView android:id="@+id/line" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/lineAdd" android:layout_width="28dp" android:layout_height="48dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/mobile_surface" android:gravity="center" android:focusable="true" android:text="+" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:layout_width="66dp" android:layout_height="wrap_content" android:gravity="center_vertical|right" android:text="弹幕透明" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/alphaSub" android:layout_width="28dp" android:layout_height="48dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/mobile_surface" android:gravity="center" android:focusable="true" android:text="-" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
                <TextView android:id="@+id/alpha" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/alphaAdd" android:layout_width="28dp" android:layout_height="48dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/mobile_surface" android:gravity="center" android:focusable="true" android:text="+" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>