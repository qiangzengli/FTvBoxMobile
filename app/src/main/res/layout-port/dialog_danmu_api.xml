<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:background="@android:color/transparent" android:orientation="vertical" android:padding="15dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="弹幕地址" android:textColor="@color/dialog_text_primary" android:textSize="16sp" />
        <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/mobile_input" android:imeOptions="actionDone|flagNoExtractUi" android:inputType="textUri" android:maxLines="1" android:paddingLeft="1dp" android:paddingTop="5dp" android:paddingRight="1dp" android:paddingBottom="5dp" android:singleLine="true" android:textColor="@color/dialog_text_primary" android:textColorHint="@color/dialog_text_hint" android:textSize="16sp" android:minHeight="48dp" android:padding="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="right" android:orientation="horizontal">
            <TextView android:id="@+id/inputDefault" android:layout_width="66dp" android:layout_height="wrap_content" android:layout_marginRight="5dp" android:background="@drawable/mobile_surface" android:focusable="true" android:gravity="center" android:padding="5dp" android:text="默认" android:textColor="@color/dialog_text_primary" android:textSize="14sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
            <TextView android:id="@+id/inputSubmit" android:layout_width="66dp" android:layout_height="wrap_content" android:background="@drawable/mobile_surface" android:focusable="true" android:gravity="center" android:padding="5dp" android:text="确定" android:textColor="@color/dialog_text_primary" android:textSize="14sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>