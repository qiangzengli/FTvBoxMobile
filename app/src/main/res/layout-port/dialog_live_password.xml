<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:layout_gravity="top|center_horizontal" android:background="@android:color/transparent" android:orientation="horizontal" android:padding="15dp">
        <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_weight="1" android:background="@drawable/mobile_input" android:hint="请输入密码" android:inputType="textPassword" android:maxLines="1" android:paddingLeft="1dp" android:paddingTop="5dp" android:paddingRight="1dp" android:paddingBottom="5dp" android:textColor="@color/dialog_text_primary" android:textColorHint="@color/dialog_text_hint" android:textSize="16sp" android:minHeight="48dp" android:padding="12dp" android:imeOptions="actionDone|flagNoExtractUi" />
        <TextView android:id="@+id/inputSubmit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginLeft="2dp" android:background="@drawable/mobile_surface" android:focusable="true" android:gravity="center" android:padding="5dp" android:text="确定" android:textColor="@color/dialog_text_primary" android:textSize="14sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
    </LinearLayout>
</FrameLayout>