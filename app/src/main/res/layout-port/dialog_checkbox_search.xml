<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp">
    <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="top|center_horizontal" android:background="@drawable/shape_dialog_pg_search_checkbox" android:orientation="vertical">
        <LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/checkAll" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_gravity="top|center_horizontal" android:gravity="center" android:background="@drawable/mobile_surface" android:clickable="true" android:focusable="true" android:padding="15dp" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:text="全选" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
            <TextView android:id="@+id/clearAll" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="5dp" android:layout_weight="1" android:layout_gravity="top|center_horizontal" android:gravity="center" android:background="@drawable/mobile_surface" android:clickable="true" android:focusable="true" android:padding="15dp" android:text="全不选" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
        </LinearLayout>
        <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridView" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" app:tv_selectedItemIsCentered="false" android:clipChildren="true" android:nestedScrollingEnabled="true" />
    </LinearLayout>
</FrameLayout>