<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" android:orientation="vertical" android:paddingLeft="16dp" android:paddingTop="12dp" android:paddingRight="16dp" android:paddingBottom="12dp" android:minHeight="0dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:shadowColor="@color/color_000000_60" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="5" android:text="投屏到设备" android:textColor="@color/dialog_text_primary" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvCastTip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="确认电视/盒子已安装TVBox或已打开DLNA投屏\n电视/盒子与手机连接在同一Wi-Fi下" android:textColor="@color/dialog_text_hint" android:textSize="14sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="10dp">
        <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:scrollbars="vertical" app:tv_layoutManager="V7LinearLayoutManager" app:tv_selectedItemIsCentered="false" app:tv_verticalSpacingWithMargins="6dp" android:clipChildren="true" android:nestedScrollingEnabled="true" />
        <ProgressBar android:id="@+id/progressBar" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|center_horizontal" android:indeterminateDrawable="@drawable/anim_loading" />
        <TextView android:id="@+id/tvScanning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="16dp" android:text="正在搜索设备..." android:textColor="@color/dialog_text_hint" android:textSize="14sp" />
        <TextView android:id="@+id/tvEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:text="未找到可用设备" android:textColor="@color/dialog_text_hint" android:textSize="14sp" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/btnRefresh" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginRight="5dp" android:layout_weight="1" android:background="@drawable/mobile_surface" android:focusable="true" android:gravity="center" android:text="刷新" android:textColor="@color/dialog_text_primary" android:textSize="14sp" android:textStyle="bold" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
        <TextView android:id="@+id/btnCancel" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginLeft="5dp" android:layout_weight="1" android:background="@drawable/mobile_surface" android:focusable="true" android:gravity="center" android:text="取消" android:textColor="@color/dialog_text_primary" android:textSize="14sp" android:textStyle="bold" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
    </LinearLayout>
</LinearLayout>