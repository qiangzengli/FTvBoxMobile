<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="播放链接" android:textSize="16sp" android:textColor="#E6EAF2" />
            <EditText android:id="@+id/mobileLinkInput" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textUri" android:imeOptions="actionGo|flagNoExtractUi" android:singleLine="true" android:hint="输入或粘贴视频、网页链接" android:background="@drawable/mobile_input" android:textColor="#FFFFFF" android:textColorHint="#A6B1C5" android:textSize="16sp" android:padding="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                <TextView android:id="@+id/pushLocal" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="粘贴链接" android:textColor="#FFFFFF" android:textSize="15sp" android:gravity="center" android:background="@drawable/mobile_surface" android:clickable="true" />
                <TextView android:id="@+id/mobilePlayLink" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="播放" android:textColor="#FFFFFF" android:textSize="15sp" android:gravity="center" android:background="@drawable/mobile_accent" android:clickable="true" />
            </LinearLayout>
            <ImageView android:id="@+id/ivQRCode" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvAddress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>