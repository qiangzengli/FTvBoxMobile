<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:background="@android:color/transparent" android:orientation="vertical" android:padding="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/mobile_input" android:hint="请输入弹幕名称" android:inputType="text" android:maxLines="1" android:paddingLeft="16dp" android:paddingTop="5dp" android:paddingRight="1dp" android:paddingBottom="5dp" android:textColor="@color/dialog_text_primary" android:textColorHint="@color/color_6CFFFFFF" android:textSize="16sp" android:minHeight="48dp" android:padding="12dp" android:imeOptions="actionSearch|flagNoExtractUi" android:singleLine="true" />
            <TextView android:id="@+id/inputSubmit" android:layout_width="64dp" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginLeft="2dp" android:background="@drawable/mobile_surface" android:focusable="true" android:gravity="center" android:padding="5dp" android:text="搜索" android:textColor="@color/dialog_text_primary" android:textSize="14sp" android:minHeight="48dp" android:focusableInTouchMode="false" android:minWidth="48dp" />
        </LinearLayout>
        <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridView" android:layout_width="match_parent" android:layout_height="240dp" android:clipChildren="true" android:clipToPadding="false" app:tv_horizontalSpacingWithMargins="3dp" app:tv_selectedItemIsCentered="false" app:tv_verticalSpacingWithMargins="3dp" android:nestedScrollingEnabled="true" android:layout_marginTop="12dp" />
        <ProgressBar android:id="@+id/loadingBar" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="top|center_horizontal" android:indeterminateBehavior="repeat" android:indeterminateDrawable="@drawable/anim_loading" android:indeterminateOnly="true" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>